# ============================================================
# 4H Sweep Algo BTCUSD — Environment Configuration
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----- Delta Exchange PRODUCTION API Credentials -----
# Get from: https://india.delta.exchange -> Account -> API Keys
DELTA_API_KEY=your_production_api_key_here
DELTA_API_SECRET=your_production_api_secret_here

# Production (India) — DO NOT change this to testnet URL
DELTA_BASE_URL=https://api.india.delta.exchange

# ----- Instrument -----
UNDERLYING_SYMBOL=BTC
FUTURES_SYMBOL=BTCUSD

# ----- Position Sizing -----
QUANTITY=30
LEVERAGE=200

# ----- Timezone -----
TIMEZONE=Asia/Kolkata

# ----- Target Premiums -----
TARGET_PREMIUM_0530=400
TARGET_PREMIUM_0930=400
TARGET_PREMIUM_1330=200

# ----- Stop Loss Multipliers (fraction of entry premium) -----
SL_MULT_0530=0.35
SL_MULT_0930=0.35
SL_MULT_1330=0.50

# ----- Premium Strike Tolerance -----
# Skip entry if no strike is within ±20% of target premium
PREMIUM_TOLERANCE=0.20

# ----- Session End (no new trades at/after this time IST) -----
SESSION_END_HOUR=17
SESSION_END_MINUTE=30

# ----- Polling -----
PNL_CHECK_INTERVAL=2
ORDER_WAIT_TIMEOUT=30

# ----- API Retry -----
MAX_RETRIES=3
RETRY_DELAY=2

# ----- Logging -----
LOG_DIR=/opt/sweep-algo-production/logs
LOG_LEVEL=INFO

# ----- Contract -----
CONTRACT_VALUE=0.001
